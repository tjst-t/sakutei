#!/bin/sh
# 自動インストール（docs/trial/redfish-os-install/README.md）。make-iso.sh が apkovl の
# /etc/local.d/autoinstall.start に入れる。Alpine の live 環境（ルートが tmpfs）でだけ動き、
# /dev/vda に setup-disk -m sys で入れて電源を切る。入れた OS の側では動かない（消してから切る）。
# Sakutei はこの中身を知らない。Workflow が見るのは BMC から見た電源と、入れた OS の観測
# （guest-os provider：ssh で届くか・/etc/os-release・目印の /etc/sakutei-installed）だけ。
#
# 設定は make-iso.sh が apkovl に置く /etc/sakutei-autoinstall.conf（無ければ既定）:
#   MARK=<目印の値>      入れた OS の /etc/sakutei-installed に書く（既定 sakutei-trial）
#   FAIL=disk|marker     試験用にわざと失敗する。disk: 何も入れずに電源を切る（インストーラが
#                        失敗しても電源を切る ISO の真似）。marker: 入れるが目印を置かない
#   ANSWER_URL=<URL>     応答ファイル（Sakutei の template-file が宣言から書き出したもの、#139）を
#                        ここから取って sh で読む。{uuid} はこの機械の DMI の UUID（小文字）に
#                        置き換わる。取れなければ（2 分）電源を切らずに止まる。応答ファイルの
#                        HOSTNAME・ADDRESS・GATEWAY・MARK・SSH_AUTHORIZED_KEYS・FAIL が上の値に勝つ
# apkovl に /etc/sakutei-ssh/authorized_keys があるか応答ファイルに SSH_AUTHORIZED_KEYS があれば、
# 入れた OS で sshd を動かし、root にその鍵で入れるようにする。/etc/sakutei-ssh/ssh_host_ed25519_key
# があればホスト鍵にする。eth0 は ADDRESS（と GATEWAY）があれば静的に、無ければ DHCP。HOSTNAME が
# あれば入れた OS の /etc/hostname に書く。
exec >/dev/ttyS0 2>&1
[ "$(awk '$2=="/"{print $3}' /proc/mounts)" = "tmpfs" ] || exit 0
MARK=sakutei-trial
FAIL=
ANSWER_URL=
HOSTNAME=
ADDRESS=
GATEWAY=
SSH_AUTHORIZED_KEYS=
[ -r /etc/sakutei-autoinstall.conf ] && . /etc/sakutei-autoinstall.conf
SSHCONF=/etc/sakutei-ssh
echo "SAKUTEI-AUTOINSTALL: start $(date -u +%FT%TZ)"
if [ -n "$ANSWER_URL" ]; then
  # 応答ファイルを取る（live の環境で eth0 を DHCP で上げる）
  modprobe virtio_net 2>/dev/null
  ip link set eth0 up
  udhcpc -i eth0 -n -q -t 10 -T 3 >/dev/null 2>&1 || { echo "SAKUTEI-AUTOINSTALL: DHCP failed; cannot fetch the answer file"; exit 1; }
  uuid=$(tr 'A-Z' 'a-z' < /sys/class/dmi/id/product_uuid 2>/dev/null)
  url=$(printf '%s' "$ANSWER_URL" | sed "s/{uuid}/$uuid/")
  i=0
  until wget -q -O /tmp/answer "$url"; do
    i=$((i+1))
    [ $i -ge 60 ] && { echo "SAKUTEI-AUTOINSTALL: cannot fetch the answer file $url"; exit 1; }
    sleep 2
  done
  . /tmp/answer || { echo "SAKUTEI-AUTOINSTALL: cannot read the answer file $url"; exit 1; }
  echo "SAKUTEI-AUTOINSTALL: answer file $url (hostname ${HOSTNAME:-none}, mark $MARK)"
  if [ -n "$SSH_AUTHORIZED_KEYS" ]; then
    mkdir -p "$SSHCONF"
    printf '%s\n' "$SSH_AUTHORIZED_KEYS" > "$SSHCONF/authorized_keys"
  fi
fi
if [ "$FAIL" = disk ]; then
  echo "SAKUTEI-AUTOINSTALL: failing on purpose (FAIL=disk); powering off without installing"
  sync; sleep 2; poweroff; exit 0
fi
cat > /tmp/answers <<'ANS'
KEYMAPOPTS=none
HOSTNAMEOPTS=sakutei-node
INTERFACESOPTS="auto lo
iface lo inet loopback
"
DNSOPTS=none
TIMEZONEOPTS=none
PROXYOPTS=none
APKREPOSOPTS="/media/cdrom/extra"
USEROPTS=none
SSHDOPTS=none
NTPOPTS=none
DISKOPTS=none
LBUOPTS=none
APKCACHEOPTS=none
ANS
setup-alpine -e -f /tmp/answers || { echo "SAKUTEI-AUTOINSTALL: setup-alpine failed"; exit 1; }
# カーネル（linux-virt）・syslinux・mkinitfs・openssh は ISO の /extra のリポジトリから入れる
printf '/media/cdrom/apks\n/media/cdrom/extra\n' > /etc/apk/repositories
apk update
if [ -r "$SSHCONF/authorized_keys" ]; then
  # live の world に足すと、setup-disk が入れる OS にも入れる
  apk add openssh || { echo "SAKUTEI-AUTOINSTALL: apk add openssh failed"; exit 1; }
fi
modprobe ext4; modprobe vfat
export BOOTLOADER=syslinux
ERASE_DISKS=/dev/vda setup-disk -m sys -s 0 /dev/vda || { echo "SAKUTEI-AUTOINSTALL: setup-disk failed"; exit 1; }
# 入れた OS を整える（ssh・目印）
mkdir -p /mnt/t
for p in /dev/vda3 /dev/vda2; do
  mount $p /mnt/t 2>/dev/null || continue
  if [ -d /mnt/t/etc/apk ]; then
    rm -f /mnt/t/etc/local.d/autoinstall.start /mnt/t/etc/sakutei-autoinstall.conf
    rm -rf /mnt/t$SSHCONF
    if [ -r "$SSHCONF/authorized_keys" ]; then
      [ -x /mnt/t/usr/sbin/sshd ] || { echo "SAKUTEI-AUTOINSTALL: sshd is not in the installed OS"; umount /mnt/t; exit 1; }
      if [ -n "$ADDRESS" ]; then
        printf 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet static\n\taddress %s\n' "$ADDRESS" > /mnt/t/etc/network/interfaces
        [ -n "$GATEWAY" ] && printf '\tgateway %s\n' "$GATEWAY" >> /mnt/t/etc/network/interfaces
      else
        printf 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet dhcp\n' > /mnt/t/etc/network/interfaces
      fi
      mkdir -p /mnt/t/root/.ssh /mnt/t/etc/ssh
      chmod 700 /mnt/t/root/.ssh
      cp "$SSHCONF/authorized_keys" /mnt/t/root/.ssh/authorized_keys
      chmod 600 /mnt/t/root/.ssh/authorized_keys
      if [ -r "$SSHCONF/ssh_host_ed25519_key" ]; then
        cp "$SSHCONF/ssh_host_ed25519_key" "$SSHCONF/ssh_host_ed25519_key.pub" /mnt/t/etc/ssh/
        chmod 600 /mnt/t/etc/ssh/ssh_host_ed25519_key
      fi
      ln -sf /etc/init.d/networking /mnt/t/etc/runlevels/boot/networking
      ln -sf /etc/init.d/sshd /mnt/t/etc/runlevels/default/sshd
      echo "SAKUTEI-AUTOINSTALL: sshd enabled on $p"
    fi
    if [ -n "$HOSTNAME" ]; then
      echo "$HOSTNAME" > /mnt/t/etc/hostname
      echo "SAKUTEI-AUTOINSTALL: hostname $HOSTNAME"
    fi
    if [ "$FAIL" = marker ]; then
      echo "SAKUTEI-AUTOINSTALL: not placing the marker on purpose (FAIL=marker)"
      rm -f /mnt/t/etc/sakutei-installed
    else
      echo "$MARK" > /mnt/t/etc/sakutei-installed
      echo "SAKUTEI-AUTOINSTALL: marked $p"
    fi
    cat > /mnt/t/etc/local.d/hello.start <<'H'
#!/bin/sh
echo "SAKUTEI-INSTALLED-OS: booted from disk: $(cat /etc/sakutei-installed 2>/dev/null || echo 'no marker')" > /dev/ttyS0
H
    chmod +x /mnt/t/etc/local.d/hello.start
    ln -sf /etc/init.d/local /mnt/t/etc/runlevels/default/local
  fi
  umount /mnt/t
done
echo "SAKUTEI-AUTOINSTALL: done, powering off"
sync; sleep 2; poweroff
